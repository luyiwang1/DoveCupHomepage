rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
        && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.enabled == true;
    }
    // Only the project owner, through the console/IAM, can grant or revoke this role.
    match /administrators/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    // Financial records remain admin-only while the free-tier client is implemented.
    // No client writes are enabled until transaction validation is emulator-tested.
    match /members/{uid} { allow read: if isAdmin() || signedIn() && request.auth.uid == uid; }
    match /payments/{id} { allow read: if isAdmin() || signedIn() && resource.data.member_id == request.auth.uid; }
    match /packages/{id} { allow read: if isAdmin() || signedIn() && resource.data.owner_id == request.auth.uid; }
    match /ledger/{id} { allow read: if isAdmin() || signedIn() && resource.data.member_id == request.auth.uid; }
    match /audit/{id} { allow read: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
