<view class="page">
  <view class="hero">
    <view class="row-between">
      <view>
        <view class="hero-title">到场记录</view>
        <view class="hero-subtitle">只记录每个人实际到场的次数</view>
      </view>
      <button class="btn secondary" size="mini" bindtap="toggleAdmin">{{isAdmin ? 'Admin 已登录' : 'Admin'}}</button>
    </view>
  </view>

  <view wx:if="{{isAdmin}}" class="card">
    <view class="section-title" style="margin-top:0">管理员补录</view>
    <button class="btn" style="width:100%" bindtap="importCurrentJoined">记录当前名单到场一次</button>
    <view class="row" style="margin-top:16rpx">
      <input class="input" style="flex:1" placeholder="姓名" value="{{nameInput}}" bindinput="onNameInput" />
    </view>
    <view class="row" style="margin-top:16rpx">
      <button class="btn secondary" bindtap="addParticipation">单人记录到场一次</button>
    </view>
    <view class="row" style="margin-top:16rpx">
      <button class="btn danger" bindtap="resetPlayer">重置此人</button>
      <button class="btn danger" bindtap="resetAllScores">重置全部</button>
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <text class="pill">到场人员 {{players.length}}</text>
      <text class="pill">最多到场 {{topAttendance}} 次</text>
    </view>
  </view>

  <view wx:if="{{!players.length}}" class="card empty">还没有到场记录</view>
  <view wx:for="{{players}}" wx:key="key" class="card">
    <view class="row-between">
      <view>
        <view style="font-size:32rpx;font-weight:900">#{{index + 1}} {{item.name}}</view>
        <view class="row" style="margin-top:12rpx">
          <text class="pill">到场 {{item.appearances || 0}} 次</text>
        </view>
      </view>
      <view class="score">{{item.appearances || 0}}</view>
    </view>
  </view>
</view>
