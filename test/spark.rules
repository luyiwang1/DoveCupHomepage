rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function admin() {
      return signed() && exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
        && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.enabled == true;
    }
    function owns(uid) { return signed() && uid == request.auth.uid; }
    function validPlan(d) { return d.plan == 'single' && d.amount_cents == 4000 || d.plan == 'package10' && d.amount_cents == 35000; }
    function paymentAfter(id) { return getAfter(/databases/$(database)/documents/payments/$(id)).data; }
    function entryAfter(id) { return getAfter(/databases/$(database)/documents/ledger/$(id)).data; }
    match /administrators/{uid} {
      allow get: if owns(uid);
      allow list, write: if false;
    }
    match /members/{uid} {
      allow read: if admin() || owns(uid);
      allow create: if owns(uid) && request.resource.data.keys().hasOnly(['display_name','phone_tail','created_at','updated_at'])
        && request.resource.data.display_name is string && request.resource.data.display_name.size() > 0 && request.resource.data.display_name.size() <= 40
        && request.resource.data.phone_tail.matches('^[0-9]{4}$') && request.resource.data.created_at == request.time && request.resource.data.updated_at == request.time;
      allow update: if owns(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name','phone_tail','updated_at'])
        && request.resource.data.display_name is string && request.resource.data.display_name.size() > 0 && request.resource.data.display_name.size() <= 40
        && request.resource.data.phone_tail.matches('^[0-9]{4}$') && request.resource.data.updated_at == request.time;
      allow delete: if false;
    }
    match /payments/{id} {
      allow read: if admin() || owns(resource.data.member_id);
      allow create: if owns(request.resource.data.member_id) && request.resource.data.keys().hasOnly(['member_id','plan','amount_cents','status','date','venue','created_at'])
        && request.resource.data.status == 'pending' && validPlan(request.resource.data)
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.venue in ['mrtc','nyta-east']
        && exists(/databases/$(database)/documents/members/$(request.auth.uid)) && request.resource.data.created_at == request.time;
      allow update: if admin() && validPlan(request.resource.data) && request.resource.data.member_id == resource.data.member_id
        && request.resource.data.date == resource.data.date && request.resource.data.venue == resource.data.venue && request.resource.data.created_at == resource.data.created_at
        && (
          resource.data.status == 'pending' && request.resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan','amount_cents'])
          || resource.data.status == 'pending' && request.resource.data.status == 'received'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','verified_at','verified_by'])
            && request.resource.data.verified_at == request.time && request.resource.data.verified_by == request.auth.uid
            && entryAfter('receipt_' + id).payment_id == id
            && (resource.data.plan == 'single' || getAfter(/databases/$(database)/documents/packages/$(id)).data.remaining == 10)
          || resource.data.status == 'received' && request.resource.data.status == 'refunded'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','refunded_at'])
            && request.resource.data.refunded_at == request.time && entryAfter('refund_' + id).payment_id == id
        );
      allow delete: if false;
    }
    match /packages/{id} {
      allow read: if admin() || owns(resource.data.owner_id) || signed() && request.auth.uid in resource.data.access_uids;
      allow create: if admin() && request.resource.data.keys().hasOnly(['owner_id','payment_id','remaining','access_uids','created_at','last_entry'])
        && request.resource.data.payment_id == id && request.resource.data.remaining == 10
        && request.resource.data.access_uids == [request.resource.data.owner_id]
        && request.resource.data.created_at == request.time && request.resource.data.last_entry == 'receipt_' + id
        && paymentAfter(id).status == 'received' && paymentAfter(id).plan == 'package10' && paymentAfter(id).member_id == request.resource.data.owner_id;
      allow update: if admin() && request.resource.data.owner_id == resource.data.owner_id && request.resource.data.payment_id == resource.data.payment_id
        && request.resource.data.created_at == resource.data.created_at && request.resource.data.remaining is int
        && request.resource.data.remaining >= 0 && request.resource.data.remaining <= 10
        && request.resource.data.access_uids is list && request.resource.data.access_uids.size() <= 20
        && request.resource.data.owner_id in request.resource.data.access_uids
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['access_uids'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remaining','last_entry'])
            && request.resource.data.last_entry != resource.data.last_entry
            && entryAfter(request.resource.data.last_entry).package_id == id
            && entryAfter(request.resource.data.last_entry).visits == request.resource.data.remaining - resource.data.remaining
        );
      allow delete: if false;
    }
    match /attendance/{id} {
      allow read: if admin() || owns(resource.data.member_id) || signed() && request.auth.uid == resource.data.owner_id;
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['member_id','owner_id','package_id','payment_id','date','venue','revision','reversed','created_at','last_entry'])
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.venue in ['mrtc','nyta-east']
        && request.resource.data.reversed is bool && entryAfter(request.resource.data.last_entry).attendance_id == id;
      allow delete: if false;
    }
    match /singleUses/{id} { allow read, create, update: if admin(); allow delete: if false; }
    match /ledger/{id} {
      allow read: if admin() || owns(resource.data.member_id) || signed() && request.auth.uid == resource.data.owner_id;
      allow create: if admin() && request.resource.data.keys().hasOnly(['kind','member_id','owner_id','amount_cents','visits','payment_id','package_id','attendance_id','actor_id','created_at'])
        && request.resource.data.actor_id == request.auth.uid && request.resource.data.created_at == request.time
        && request.resource.data.amount_cents is int && request.resource.data.visits is int
        && (
          request.resource.data.kind == 'payment' && id == 'receipt_' + request.resource.data.payment_id
            && paymentAfter(request.resource.data.payment_id).status == 'received'
            && request.resource.data.amount_cents == paymentAfter(request.resource.data.payment_id).amount_cents
            && request.resource.data.member_id == paymentAfter(request.resource.data.payment_id).member_id
            && request.resource.data.visits == (paymentAfter(request.resource.data.payment_id).plan == 'package10' ? 10 : 0)
          || request.resource.data.kind == 'refund' && id == 'refund_' + request.resource.data.payment_id
            && paymentAfter(request.resource.data.payment_id).status == 'refunded'
            && request.resource.data.amount_cents == -paymentAfter(request.resource.data.payment_id).amount_cents
            && request.resource.data.member_id == paymentAfter(request.resource.data.payment_id).member_id
            && request.resource.data.visits == (paymentAfter(request.resource.data.payment_id).plan == 'package10' ? -10 : 0)
          || request.resource.data.kind in ['usage','attendance','reversal'] && request.resource.data.amount_cents == 0
            && request.resource.data.visits in [-1,0,1]
            && getAfter(/databases/$(database)/documents/attendance/$(request.resource.data.attendance_id)).data.last_entry == id
        );
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
